# Copy this file to `.env` and fill in the values.
#
# All four already exist in the LauraHomes project — this app reuses the same
# database and the same OpenAI account. Do NOT copy the rest of that file
# across: no Stripe, AWS, n8n or JWT value is used here, and shipping them
# would put live credentials in a deployment with no use for them.
#
# `.env` is gitignored. This example file carries names only, never values.

# Required. The same MySQL connection string LauraHomes uses.
# Format: mysql://user:password@host:3306/database
DATABASE_URL=

# Required. Every completed questionnaire spends OpenAI credit.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=

# Optional. Set to "false" ONLY for a local database with no SSL.
# Leave unset in production — RDS wants SSL and the default path enables it.
DATABASE_SSL=

# --- Auth -------------------------------------------------------------------
#
# Required. These MUST be byte-for-byte the same values LauraHomes uses.
#
# Sign-in reads the same `users` table and writes to the same `sessions` table,
# and both apps verify each other's tokens. Different secrets here would not
# fail loudly — sign-in would simply work while every session minted in the
# other app was silently rejected.
#
# LauraHomes also sets JWT_VERIFICATION_SECRET. That one is NOT needed here:
# this app never sends a verification email.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Optional. Where the "create an account" and "verify your email" links point.
# This app cannot create accounts — LauraHomes owns that, and the verification
# email with it. Defaults to https://laurahomes.vercel.app; set this when that
# moves to a real domain.
NEXT_PUBLIC_LAURAHOMES_URL=
