# Copy this file to `.env` and fill in the values.
#
# Every one of these already exists in the LauraHomes project — this app reuses
# the same database, the same OpenAI account, the same JWT secrets and the same
# mail webhook. Do NOT copy the rest of that file across: no Stripe or AWS
# value is used here, and shipping them would put live credentials in a
# deployment with no use for them.
#
# `.env` is gitignored. This example file carries names only, never values.

# Required. The same MySQL connection string LauraHomes uses.
# Format: mysql://user:password@host:3306/database
DATABASE_URL=

# Required. Every completed questionnaire spends OpenAI credit.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=

# Optional. Set to "false" ONLY for a local database with no SSL.
# Leave unset in production — RDS wants SSL and the default path enables it.
DATABASE_SSL=

# --- Auth -------------------------------------------------------------------
#
# Required. All three MUST be byte-for-byte the same values LauraHomes uses.
#
# Signing up and signing in read and write the same `users` and `sessions`
# tables, and both apps verify each other's tokens. Different secrets here
# would not fail loudly — this app would work on its own while every session
# minted in the other one was silently rejected, and a verification link
# emailed by one would be refused by the other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_VERIFICATION_SECRET=

# Required for registration. The N8N webhook that actually sends mail — the
# same one LauraHomes posts to, so both apps send from the same address.
# Without it, sign-in still works but nobody can create an account: the
# verification email fails to send and the account stays unverified forever.
N8N_EMAIL_WEBHOOK_URL=

# Optional. Absolute base URL used to build the link inside the verification
# email. Detected from the request when unset, which is right in every normal
# case; set it if this ever sends mail outside a request (a cron, a worker).
APP_URL=
